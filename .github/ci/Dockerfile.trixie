FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    gcc \
    git \
    gnat \
    gprbuild \
    libahven-dev \
    libanet-dev \
    libc6-dev \
    make \
    pandoc \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

CMD ["/bin/sh"]
